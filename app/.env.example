# Database
DATABASE_URL=postgresql+asyncpg://smartsol:smartpass@localhost:5434/smartdb

# JWT
JWT_SECRET=change_this_to_a_strong_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MIN=60

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000"]

# OpenRouter Configuration (LLM)
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-chat

# OpenRouter Headers (Required)
OPENROUTER_HTTP_REFERER=http://localhost:8000
OPENROUTER_APP_NAME=AI-Support-Agent

# Embeddings (Cohere)
EMBEDDING_API_KEY=your-cohere-api-key
EMBEDDING_MODEL=embed-v4.0
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
VECTOR_DIMENSIONS=1536

# RAG
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_FILE_SIZE=10

# Rate Limiting
RATE_LIMIT_ENABLED=true
DEFAULT_RATE_LIMIT=20/minute

# Request Timeout (seconds)
REQUEST_TIMEOUT_SECONDS=120

# App
LOG_LEVEL=INFO
