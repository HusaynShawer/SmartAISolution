# Copy this file to `.env` at the project root, then fill in the values.
# `docker compose up --build` will use these values for the app container.

# Required
OPENROUTER_API_KEY=sk-or-your-openrouter-api-key
EMBEDDING_API_KEY=your-cohere-or-openai-embedding-key

# Optional (defaults shown)
JWT_SECRET=change_me_to_a_strong_random_string
LLM_MODEL=deepseek/deepseek-chat
EMBEDDING_MODEL=
DB_PORT=5434
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
DEFAULT_RATE_LIMIT=20/minute
REQUEST_TIMEOUT_SECONDS=120
LOG_LEVEL=INFO